#!/bin/sh
#SBATCH --partition=epyc
#SBATCH --time=3-00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --job-name=BENCHMARK_Explain_LS-GKM_RPT_1
#SBATCH --error=%x-%J.out
#SBATCH --output=%x-%J.out

# Environment
eval "$(conda shell.bash hook)"
conda activate mLS-GKM

RPT=${RPT:-1}

OUT_DIR=Speed_EVAL/Explain_LS-GKM/RPT_${RPT}
mkdir -p "$OUT_DIR"

FASTA=FASTAs/wgEncodeBroadHistoneH1hescCtcfStdAlnRep0/test_combined.fa
MODEL=Models/LS-GKM_Models/wgEncodeBroadHistoneH1hescCtcfStdAlnRep0.model.txt
# SET WITH YOUR PATH TO THE ORIGINAL LS-GKM gkmexplain BINARY
BIN="/trinity/home/c24080990/scratch/ORIGINAL_lsgkm/bin/gkmexplain"

TMP_DIR=/tmp/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_RPT_${RPT}
mkdir -p "$TMP_DIR"

LOCAL_FASTA=$TMP_DIR/$(basename "$FASTA")
LOCAL_MODEL=$TMP_DIR/$(basename "$MODEL")
LOCAL_BIN=$TMP_DIR/$(basename "$BIN")

cp "$FASTA" "$LOCAL_FASTA"
cp "$MODEL" "$LOCAL_MODEL"
cp "$BIN" "$LOCAL_BIN"
chmod +x "$LOCAL_BIN"

"$LOCAL_BIN" \
    "$LOCAL_FASTA" \
    "$LOCAL_MODEL" \
    "$TMP_DIR/predictions.txt" &

PID=$!
psrecord $PID --interval 1 --plot "$TMP_DIR/resource_usage.png" --log "$TMP_DIR/resource_usage.csv" --log-format "csv"

cp "$TMP_DIR/predictions.txt" "$OUT_DIR/predictions.txt"
cp "$TMP_DIR/resource_usage.png" "$OUT_DIR/resource_usage.png"
cp "$TMP_DIR/resource_usage.csv" "$OUT_DIR/resource_usage.csv"
