#!/bin/sh
#SBATCH --partition=epyc
#SBATCH --time=3-00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=750M
#SBATCH --job-name=BENCHMARK_Explain_mLS-GKM_RPT_1
#SBATCH --error=%x-%J.out
#SBATCH --output=%x-%J.out

# Environment
eval "$(conda shell.bash hook)"
conda activate mLS-GKM


RPT=${RPT:-1}

THREADS=${THREADS:?ERROR: THREADS must be set explicitly (e.g. THREADS=1); refusing to default}

OUT_DIR=Speed_EVAL/Explain_mLS-GKM/THREADS_${THREADS}/RPT_${RPT}
mkdir -p "$OUT_DIR"

FASTA=FASTAs/wgEncodeBroadHistoneH1hescCtcfStdAlnRep0/test_combined.fa
MODEL=Models/mLS-GKM_Models/wgEncodeBroadHistoneH1hescCtcfStdAlnRep0.model.txt
BIN=../../../bin/gkmexplain

TMP_DIR=/tmp/${SLURM_JOB_NAME}_${SLURM_JOB_ID}_THREADS_${THREADS}_RPT_${RPT}
mkdir -p "$TMP_DIR"

LOCAL_FASTA=$TMP_DIR/$(basename "$FASTA")
LOCAL_MODEL=$TMP_DIR/$(basename "$MODEL")
LOCAL_BIN=$TMP_DIR/$(basename "$BIN")

cp "$FASTA" "$LOCAL_FASTA"
cp "$MODEL" "$LOCAL_MODEL"
cp "$BIN" "$LOCAL_BIN"
chmod +x "$LOCAL_BIN"

"$LOCAL_BIN" \
    -t ${THREADS} \
    -D \
    "$LOCAL_FASTA" \
    "$LOCAL_MODEL" \
    "$TMP_DIR/predictions.txt" &

PID=$!
psrecord $PID --interval 1 --plot "$TMP_DIR/resource_usage.png" --log "$TMP_DIR/resource_usage.csv" --log-format "csv"

cp "$TMP_DIR/predictions.txt" "$OUT_DIR/predictions.txt"
cp "$TMP_DIR/resource_usage.png" "$OUT_DIR/resource_usage.png"
cp "$TMP_DIR/resource_usage.csv" "$OUT_DIR/resource_usage.csv"
